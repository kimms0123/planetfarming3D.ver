  lines:
  - typeName: "\uC989\uC2DC \uD310\uB9E4\uD615"
    greet:
    - "\uC654\uAD6C\uB098! \uC624\uB298\uB3C4 \uC2DC\uC6D0\uD558\uAC8C \uD314\uACE0
