    talk: 2
    time: 2
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC810\uC2EC\uC740 \uBA39\uC5C8\uC5B4? \uB098\uB294 \uC544\uC9C1!"
    - "\uC5EC\uD589\uD558\uB2E4 \uBCF4\uBA74 \uBC25\uB54C\uB97C \uC790\uAFB8 \uAE4C\uBA39\uC5B4\uBED0\uB054."
