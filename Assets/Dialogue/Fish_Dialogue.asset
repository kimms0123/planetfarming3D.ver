    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBC24\uC5D4 \uC6B0\uC8FC\uC120 \uC9C0\uBD95\uC5D0 \uB204\uC6CC\uC11C \uBCC4\uC744
      \uC138."
    - "\uB108\uB3C4 \uBCC4 \uC138\uB294 \uAC70 \uC88B\uC544\uD574\uBED0\uB054?"
    choices:
    - text: "\uC88B\uC544\uD574"
      reply: "\uADF8\uB7FC \uB2E4\uC74C\uC5D0 \uAC19\uC774 \uC138\uC790! \uB0B4\uAC00
        \uBCC4 \uC774\uB984 \uB2E4 \uC54C\uB824 \uC904\uAC8C\uBED0\uB054!"
      action: 0
    - text: "\uAE08\uBC29 \uC878\uB824"
      reply: "\uD5E4\uD5E4, \uB098\uB3C4 \uBC31 \uAC1C\uCBE4 \uC138\uBA74 \uC7A0\uB4E4\uC5B4\uBED0\uB054."
      action: 0
  - id: "\uB610\uC634"
