  npcName: "\uBED0\uB054\uC774"
  entries:
  - id: "\uCCAB\uB9CC\uB0A8"
    priority: 100
    weight: 1
    onceOnly: 1
    talk: 1
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBED0\uB054! \uBED0\uB054! \uC548\uB155! \uC774 \uD589\uC131\uC5D0\uB3C4
      \uB204\uAC00 \uC0B4\uACE0 \uC788\uC5C8\uAD6C\uB098!"
    - "\uB098\uB294 \uBED0\uB054\uC774! \uC6B0\uC8FC\uC120\uC744 \uD0C0\uACE0 \uBCC4
      \uBC14\uB2E4\uB97C \uC5EC\uD589\uD558\uACE0 \uC788\uC5B4\uBED0\uB054."
    - "\uBC8C\uC368 \uD589\uC131\uC744 \uC2A4\uBB34 \uAC1C\uB3C4 \uB118\uAC8C \uB2E4\uB154\uB294\uB370,
      \uC5EC\uAE30\uCC98\uB7FC \uBC14\uB2E4\uAC00 \uBC18\uC9DD\uC774\uB294 \uACF3\uC740
      \uCC98\uC74C\uC774\uC57C!"
    - "\uD55C\uB3D9\uC548 \uC5EC\uAE30 \uBA38\uBB3C\uB7EC\uB3C4 \uB420\uAE4C\uBED0\uB054?"
    choices:
    - text: "\uBB3C\uB860\uC774\uC9C0!"
      reply: "\uC57C\uD638! \uC624\uB298\uBD80\uD130 \uC5EC\uAE30\uAC00 \uB0B4 \uC815\uAC70\uC7A5\uC774\uC57C\uBED0\uB054!"
      action: 0
    - text: "\uC5BC\uB9C8\uB098 \uC788\uC744 \uAC74\uB370?"
      reply: "\uC74C\u2026 \uB9C8\uC74C\uC5D0 \uB4E4 \uB54C\uAE4C\uC9C0? \uADF8\uB7EC\uB2C8\uAE4C
        \uC544\uC8FC \uC624\uB798\uBED0\uB054!"
      action: 0
  - id: "\uD018\uC2A4\uD2B8_\uAC74\uB124\uAE30"
    priority: 60
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 11400000, guid: 72e2d8a0cf7efb840b24a48c1ad109e7, type: 2}
    questState: 3
    lines:
    - "\uBED0\uB054?! \uADF8\uAC70 {item} \uC544\uB2C8\uC57C? {have}\uAC1C\uB098
      \uC788\uB124!"
    choices:
    - text: "\uAC74\uB124\uC8FC\uAE30"
      reply: "\uC640\uC544, \uACE0\uB9C8\uC6CC! \uC774\uAC74 \uC5EC\uD589\uD558\uBA74\uC11C
        \uBAA8\uC740 \uAC70\uC57C. ({reward}\uBCA8)"
      action: 2
    - text: "\uC544\uC9C1\uC774\uC57C"
      reply: "\uAD1C\uCC2E\uC544, \uC900\uBE44\uB418\uBA74 \uC918\uBED0\uB054!"
      action: 0
  - id: "\uD018\uC2A4\uD2B8_\uC81C\uC548"
    priority: 50
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 11400000, guid: 72e2d8a0cf7efb840b24a48c1ad109e7, type: 2}
    questState: 1
    lines:
    - "\uC788\uC796\uC544\u2026 \uC6B0\uC8FC\uC120 \uB0C9\uC7A5\uACE0\uAC00 \uD145
      \uBE44\uC5C8\uC5B4."
    - "\uD639\uC2DC {item} {amount}\uAC1C\uB9CC \uB098\uB220 \uC904 \uC218 \uC788\uC5B4\uBED0\uB054?"
    choices:
    - text: "\uC88B\uC544!"
      reply: "\uACE0\uB9C8\uC6CC! \uCC9C\uCC9C\uD788 \uAC00\uC838\uC640\uB3C4 \uB3FC\uBED0\uB054!"
      action: 1
    - text: "\uB2E4\uC74C\uC5D0"
      reply: "\uC751\u2026 \uBC30 \uAF2C\uB974\uB975 \uC18C\uB9AC \uB4E4\uB824\uB3C4
        \uBAA8\uB978 \uCC99\uD574 \uC918\uBED0\uB054."
      action: 0
