    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB0B4 \uC6B0\uC8FC\uC120 \uC774\uB984\uC740 '\uBF40\uAE00\uD638'\uC57C."
    - "\uC5D4\uC9C4\uC5D0\uC11C \uAC70\uD488\uC774 \uBF40\uAE00\uBF40\uAE00 \uB098\uC640\uC11C
      \uADF8\uB807\uAC8C \uC9C0\uC5C8\uC5B4\uBED0\uB054!"
