    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC800\uB141 \uD558\uB298\uC5D0 \uBCC4\uC774 \uD558\uB098\uC529 \uCF1C\uC9C0\uACE0
      \uC788\uC5B4!"
    - "\uC800 \uC911\uC5D0 \uB0B4\uAC00 \uAC14\uB358 \uBCC4\uB3C4 \uC788\uC744\uAC78\uBED0\uB054?"
    choices: []
