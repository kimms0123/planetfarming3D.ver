    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC800\uAE30 \uC0C1\uC5B4 \uC544\uC800\uC528, \uBB34\uC12D\uAC8C \uC0DD\uACBC\uC9C0?"
    - "\uADFC\uB370 \uC5B4\uC81C \uB098 \uC6B0\uC8FC\uC120 \uACE0\uCE58\uB294 \uAC70
      \uBAB0\uB798 \uB3C4\uC640\uC92C\uC5B4. \uBE44\uBC00\uC774\uC57C\uBED0\uB054!"
