    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC6B0\uC640\uC544, \uC6B0\uC8FC \uD3ED\uD48D\uBCF4\uB2E4 \uC138\uB2E4!"
    - "\uC6B0\uC8FC\uC120 \uB0A0\uC544\uAC08\uAE4C \uBD10 \uAF49 \uBB36\uC5B4 \uB480\uC5B4.
