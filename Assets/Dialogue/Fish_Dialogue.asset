    time: 1
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC88B\uC740 \uC544\uCE68! \uC6B0\uC8FC\uC120 \uCC3D\uBB38\uC73C\uB85C \uD574
      \uB728\uB294 \uAC70 \uBD24\uC5B4?"
    - "\uC774 \uD589\uC131 \uD574\uB294 \uAF2D \uB2EC\uAC40 \uB178\uB978\uC790 \uAC19\uC544\uBED0\uB054!"
    choices: []
  - id: "\uC778\uC0AC_\uB0AE"
    priority: 20
