%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fb884e02e99ddb846af38f945d816b6f, type: 3}
  m_Name: Shark_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::FarmingSystem.Dialogue.DialogueSet
  npcName: "\uC0E4\uD06C"
  entries:
  - id: "\uCCAB\uB9CC\uB0A8"
    priority: 100
    weight: 1
    onceOnly: 1
    talk: 1
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\u2026\uBB58 \uADF8\uB807\uAC8C \uCCD0\uB2E4\uBD10. \uC774\uBE68 \uCC98\uC74C
      \uBCF4\uB0D0?"
    - "\uB09C \uC0E4\uD06C\uB2E4. \uC774 \uADFC\uCC98 \uBB3C\uAC00\uB294 \uB0B4 \uAD6C\uC5ED\uC774\uB2C8\uAE4C
      \uD568\uBD80\uB85C \uCCA8\uBC99\uB300\uC9C0 \uB9C8\uB77C\uC0E5."
    - "\u2026\uADF8\uB798\uB3C4 \uAE38 \uC783\uC73C\uBA74 \uBD88\uB7EC. \uB531\uD788
      \uAC71\uC815\uB3FC\uC11C \uADF8\uB7EC\uB294 \uAC74 \uC544\uB2C8\uACE0\uC0E5."
    choices:
    - text: "\uACE0\uB9C8\uC6CC!"
      reply: "\uACE0, \uACE0\uB9D9\uAE34 \uBB58! \uADF8\uB0E5 \uD558\uB294 \uB9D0\uC774\uB77C\uACE0\uC0E5!"
      action: 0
    - text: "\uC774\uBE68 \uBA4B\uC788\uB2E4"
      reply: "\u2026\uD765. \uBCF4\uB294 \uB208\uC740 \uC788\uB124. \uB9E4\uC77C
        \uC544\uCE68 300\uBC88\uC529 \uB2E6\uB294\uB2E4\uC0E5."
      action: 0
  - id: "\uD0DC\uD48D"
    priority: 30
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 3
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC774\uB7F0 \uB0A0 \uBC16\uC5D0 \uC65C \uB3CC\uC544\uB2E4\uB140! \uB0A0\uC544\uAC00\uBA74
      \uC5B4\uCA4C\uB824\uACE0!"
    - "\u2026\uBE68\uB9AC \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00. \uBC2D\uC740 \uB0B4\uAC00
      \uB300\uCDA9 \uBD10 \uC904 \uD14C\uB2C8\uAE4C\uC0E5."
    choices: []
  - id: "\uC778\uC0AC_\uC544\uCE68"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 1
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC544\uCE68\uBD80\uD130 \uBD80\uC9C0\uB7F0 \uB5A8\uAE34."
    - "\u2026\uB098\uB3C4 \uBC29\uAE08 \uC77C\uC5B4\uB09C \uAC70 \uC544\uB2C8\uB2E4.
      \uD55C\uCC38 \uC804\uC5D0 \uC77C\uC5B4\uB0AC\uB2E4\uC0E5."
    choices: []
  - id: "\uC778\uC0AC_\uB0AE"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 2
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB365\uB2E4. \uC774\uB7F4 \uB550 \uC2DC\uC6D0\uD55C \uBC14\uB2F7\uBB3C\uC5D0
      \uC3D9 \uB4E4\uC5B4\uAC00 \uC788\uB294 \uAC8C \uCD5C\uACE0\uC57C."
    - "\uB108\uB3C4 \uAC19\uC774\u2026 \uC544, \uC544\uB2C8\uB2E4. \uD63C\uC790 \uB4E4\uC5B4\uAC08
      \uAC70\uB2E4\uC0E5."
    choices: []
  - id: "\uC778\uC0AC_\uC800\uB141"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 3
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uD574 \uC9C8 \uB54C \uBC14\uB2E4\uAC00 \uC8FC\uD669\uC0C9\uC774 \uB418\uB294
      \uAC70 \uC54C\uC544?"
    - "\u2026\uB531\uD788 \uC608\uC058\uB2E4\uB294 \uAC74 \uC544\uB2C8\uACE0, \uADF8\uB0E5
      \uADF8\uB807\uB2E4\uACE0\uC0E5."
    choices: []
  - id: "\uC778\uC0AC_\uBC24"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 4
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC774 \uC2DC\uAC04\uC5D0 \uBB50 \uD574. \uC5B4\uB450\uC6B4 \uB370\uC11C \uB3CC\uC544\uB2E4\uB2C8\uBA74
      \uC704\uD5D8\uD558\uB2E4."
    - "\u2026\uD639\uC2DC \uBB34\uC11C\uC6CC\uC11C \uBABB \uC790\uB294 \uAC70\uB0D0?"
    choices:
    - text: "\uC870\uAE08 \uBB34\uC11C\uC6CC"
      reply: "\uCE6B, \uC5B4\uCA54 \uC218 \uC5C6\uC9C0. \uB0B4\uAC00 \uC5EC\uAE30
        \uC788\uC744 \uD14C\uB2C8\uAE4C \uC548\uC2EC\uD558\uACE0 \uAC00\uB77C\uC0E5."
      action: 0
    - text: "\uC544\uB2C8\uAC70\uB4E0!"
      reply: "\uD765, \uB204\uAC00 \uAC71\uC815\uD588\uB300? \uC5BC\uB978 \uC790\uB77C\uC0E5."
      action: 0
  - id: "\uB610\uC634"
    priority: 10
    weight: 1
    onceOnly: 0
    talk: 3
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB610 \uC654\uB0D0? \u2026\uD560 \uC77C \uC5C6\uC73C\uBA74 \uC5EC\uAE30 \uC880
      \uC549\uC544 \uC788\uB2E4 \uAC00\uB4E0\uAC00\uC0E5."
    choices: []
  - id: "\uB610\uC6342"
    priority: 10
    weight: 1
    onceOnly: 0
    talk: 3
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC790\uAFB8 \uC624\uB124. \uB0B4\uAC00 \uADF8\uB807\uAC8C \uC88B\uB0D0? \u2026\uC544,
      \uC544\uB2C8\uBA74 \uB410\uB2E4\uC0E5."
    choices: []
  - id: "\uC7A1\uB2F4_\uC774\uBE68"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC774\uBE68\uC774 \uBE60\uC838\uB3C4 \uC0C8\uB85C \uB09C\uB2E4. \uD3C9\uC0DD
      3\uB9CC \uAC1C\uCBE4?"
    - "\u2026\uC790\uB791\uD558\uB294 \uAC70 \uB9DE\uB2E4\uC0E5."
    choices: []
  - id: "\uC7A1\uB2F4_\uBC2D"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB124 \uBC2D \uB9D0\uC774\uC57C. \uC5B4\uC81C \uC9C0\uB098\uAC00\uB2E4 \uBD24\uB294\uB370\u2026"
    - "\u2026\uAF64 \uC798 \uD0A4\uC6B0\uB354\uB77C. \uC544, \uC6B0\uC5F0\uD788 \uBCF8
      \uAC70\uB2E4\uC0E5."
    choices: []
  - id: "\uC7A1\uB2F4_\uBC84\uC12F"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC800\uAE30 \uCABC\uADF8\uB9CC \uBC84\uC12F \uB140\uC11D \uB9D0\uC774\uC57C.
      \uC790\uAFB8 \uB0B4 \uADF8\uB9BC\uC790\uC5D0 \uC228\uC5B4."
    - "\u2026\uBB50, \uBE44\uCF1C \uC904 \uC0DD\uAC01\uC740 \uC5C6\uB2E4\uC0E5."
    choices: []
  - id: "\uC9C8\uBB38_\uBB34\uC11C\uC6CC"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC194\uC9C1\uD788 \uB9D0\uD574. \uB098 \uCC98\uC74C \uBD24\uC744 \uB54C \uBB34\uC11C\uC6E0\uC9C0?"
    choices:
    - text: "\uC751, \uC870\uAE08"
      reply: "\u2026\uADF8\uB807\uAD6C\uB098. \uC6C3\uB294 \uC5F0\uC2B5 \uC880 \uD574\uC57C\uACA0\uB2E4\uC0E5."
      action: 0
    - text: "\uC804\uD600!"
      reply: "\uAC70, \uAC70\uC9D3\uB9D0! \u2026\uADF8\uB798\uB3C4 \uACE0\uB9D9\uB2E4\uC0E5."
      action: 0
  - id: "\uC9C8\uBB38_\uC0DD\uC120"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBB3C\uC5B4\uBCFC \uAC8C \uC788\uB294\uB370\u2026 \uB108 \uC0DD\uC120 \uC88B\uC544\uD558\uB0D0?"
    choices:
    - text: "\uC88B\uC544\uD574"
      reply: "\u2026\uADF8\uB798? \uB2E4\uC74C\uC5D0 \uC7A1\uC73C\uBA74 \uD558\uB098
        \uC904\uAC8C. \uB9CE\uC774 \uC7A1\uD600\uC11C \uADF8\uB7EC\uB294 \uAC70\uB2E4\uC0E5."
      action: 0
    - text: "\uBCC4\uB85C"
      reply: "\uD765, \uB9DB\uC744 \uBAA8\uB974\uB294\uAD6C\uBA3C. \u2026\uADF8\uB7FC
        \uC791\uBB3C\uC774\uB77C\uB3C4 \uD0A4\uC6CC\uC11C \uBA39\uC5B4\uB77C\uC0E5."
      action: 0
  - id: "\uBE44"
    priority: 0
    weight: 3
    onceOnly: 0
    talk: 0
    time: 0
    weather: 2
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBE44 \uC624\uB294 \uB0A0\uC774 \uC88B\uB2E4. \uB545 \uC704\uC5D0\uC11C\uB3C4
      \uBB3C\uC18D \uAC19\uAC70\uB4E0."
    - "\u2026\uC624\uB298\uC740 \uAE30\uBD84\uC774 \uC88B\uC73C\uB2C8\uAE4C \uB9D0
      \uC880 \uAC78\uC5B4\uB3C4 \uB41C\uB2E4\uC0E5."
    choices: []
  - id: "\uB9D1\uC74C"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 1
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uCA0D\uCA0D\uD558\uB124. \uC9C0\uB290\uB7EC\uBBF8\uAC00 \uBC14\uC0AD\uD574\uC9C8
      \uAC83 \uAC19\uB2E4."
    - "\u2026\uBB3C \uC880 \uBFCC\uB824 \uC904 \uAC70\uBA74 \uBFCC\uB824 \uC8FC\uB4E0\uAC00\uC0E5."
    choices: []
  - id: "\uBD04"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 1
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBD04\uC774\uB77C\uACE0 \uB2E4\uB4E4 \uB4E4\uB5A0 \uC788\uB124."
    - "\u2026\uB098\uB3C4 \uAF43 \uD558\uB098\uCBE4\uC740 \uBD10 \uC904 \uC218 \uC788\uB2E4\uC0E5."
    choices: []
  - id: "\uC5EC\uB984"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 2
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC5EC\uB984\uC740 \uB0B4 \uACC4\uC808\uC774\uB2E4!"
    - "\uBC14\uB2E4\uAC00 \uB530\uB73B\uD574\uC11C \uD558\uB8E8 \uC885\uC77C \uD5E4\uC5C4\uCE60
      \uC218 \uC788\uB2E4\uC0E5!"
    choices: []
  - id: "\uAC00\uC744"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 3
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uAC00\uC744\uC5D4 \uC791\uBB3C\uC774 \uC794\uB729 \uC775\uC9C0."
    - "\u2026\uB0A8\uB294 \uAC70 \uC788\uC73C\uBA74 \uB098\uB220 \uC918\uB3C4 \uB41C\uB2E4.
      \uB531\uD788 \uB2EC\uB77C\uB294 \uAC74 \uC544\uB2C8\uACE0\uC0E5."
    choices: []
  - id: "\uACA8\uC6B8"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 4
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uCD94, \uCD94\uC6B4 \uAC70 \uC544\uB2C8\uB2E4. \uC774\uBE68\uC774 \uB531\uB531
      \uBD80\uB52A\uD788\uB294 \uAC74 \uC6D0\uB798 \uADF8\uB7F0 \uAC70\uB2E4\uC0E5."
    - "\u2026\uBAA9\uB3C4\uB9AC \uAC19\uC740 \uAC70 \uC788\uC73C\uBA74 \uBE4C\uB824\uC8FC\uB4E0\uAC00\uC0E5."
    choices: []
