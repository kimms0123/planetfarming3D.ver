    season: 4
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uCC28\uAC00\uC6CC\uC694\u2026 \uAC13 \uC704\uC5D0 \uB208\uC774 \uC313\uC774\uBA74
