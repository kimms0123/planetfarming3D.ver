    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC5EC\uB984\uC740 \uBB34\uC11C\uC6CC\uC694\u2026"
    - "\uD587\uBCD5\uC5D0 \uBC14\uC2F9 \uB9D0\uB77C\uC11C \uBC84\uC12F \uACFC\uC790\uAC00
      \uB420\uC9C0\uB3C4 \uBAB0\uB77C\uC694\u2026"
