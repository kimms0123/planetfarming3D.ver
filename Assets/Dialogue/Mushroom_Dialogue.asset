    season: 3
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uAC00\uC744\uC740 \uBC84\uC12F\uC758 \uACC4\uC808\uC774\uC5D0\uC694!"
    - "\uC624\uB298\uB530\uB77C \uB0B4\uAC00 \uB354 \uBC18\uC9DD\uBC18\uC9DD\uD574
      \uBCF4\uC774\uC9C0 \uC54A\uC544\uC694?"
    choices:
    - text: "\uBC18\uC9DD\uBC18\uC9DD\uD574!"
      reply: "\uD5E4\uD5E4, \uAC13 \uB2E6\uB290\uB77C \uC544\uCE68\uBD80\uD130 \uBC14\uBE74\uAC70\uB4E0\uC694\uBF40\uC694!"
      action: 0
    - text: "\uC798 \uBAA8\uB974\uACA0\uC5B4"
      reply: "\uC5D0\uC787, \uC790\uC138\uD788 \uBD10\uC694! \uC5EC\uAE30, \uC5EC\uAE30
        \uBC18\uC9DD\uC774\uC796\uC544\uC694\uBF40\uC694!"
      action: 0
  - id: "\uACA8\uC6B8"
    priority: 0
