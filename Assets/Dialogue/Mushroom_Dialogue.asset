  m_Script: {fileID: 11500000, guid: fb884e02e99ddb846af38f945d816b6f, type: 3}
  m_Name: Mushroom_Dialogue
  m_EditorClassIdentifier: Assembly-CSharp::FarmingSystem.Dialogue.DialogueSet
  npcName: "\uBC84\uC12F\uB3CC\uC774"
  entries:
  - id: "\uCCAB\uB9CC\uB0A8"
    priority: 100
    weight: 1
    onceOnly: 1
    talk: 1
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC557! \uBC14, \uBC1F\uC9C0 \uB9C8\uC694! \uC5EC\uAE30 \uC544\uB798\uC608\uC694,
      \uC544\uB798!"
    - "\u2026\uD734, \uD070\uC77C \uB0A0 \uBED4\uD588\uBF40\uC694. \uB098\uB294 \uBC84\uC12F\uB3CC\uC774\uC608\uC694!"
    - "\uC6B0\uC8FC\uB97C \uB465\uB465 \uB5A0\uB2E4\uB2C8\uB2E4\uAC00 \uC5EC\uAE30
      \uC3D9 \uB0B4\uB824\uC549\uC558\uC5B4\uC694. \uC774 \uD589\uC131 \uD759, \uCD09\uCD09\uD558\uACE0
      \uD3ED\uC2E0\uD574\uC11C \uB9C8\uC74C\uC5D0 \uB4E4\uC5B4\uC694."
    - "\uC624\uB298\uBD80\uD130 \uC5EC\uAE30\uAC00 \uC6B0\uB9AC \uC9D1\uC774\uBF40\uC694!
      \uC6B0\uB9AC \uCE5C\uD558\uAC8C \uC9C0\uB0B4\uC694?"
    choices:
    - text: "\uC88B\uC544!"
      reply: "\uC640\uC544! \uD3EC\uC790\uAC00 \uB9C9 \uD401\uD401 \uB098\uC640\uC694!
        \uC798 \uBD80\uD0C1\uD574\uC694\uBF40\uC694!"
      action: 0
    - text: "\uC870\uAE08 \uC0DD\uAC01\uD574 \uBCFC\uAC8C"
      reply: "\uD788\uC789\u2026 \uADF8\uB798\uB3C4 \uAE30\uB2E4\uB9B4\uAC8C\uC694.
        \uB098\uB294 \uC6D0\uB798 \uBABB \uC6C0\uC9C1\uC774\uBF40\uC694."
      action: 0
  - id: "\uD0DC\uD48D"
    priority: 30
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 3
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC73C\uC557, \uBC14\uB78C\uC5D0 \uB0A0\uC544\uAC08 \uAC83 \uAC19\uC544\uC694!"
    - "\uB0B4 \uC904\uAE30 \uAF2D \uC7A1\uC544 \uC918\uC694\uBF40\uC694! \uB193\uC73C\uBA74
      \uC548 \uB3FC\uC694!"
    choices: []
  - id: "\uC778\uC0AC_\uC544\uCE68"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 1
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC73C\uC74C\u2026 \uC544\uC9C1 \uC878\uB824\uC694\u2026"
    - "\uC774\uC2AC \uD55C \uBC29\uC6B8\uB9CC \uB354 \uB9C8\uC2DC\uACE0 \uC77C\uC5B4\uB0A0\uB798\uBF40\uC694\u2026"
    choices: []
  - id: "\uC778\uC0AC_\uB0AE"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 2
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uD587\uBCD5\uC774 \uB108\uBB34 \uC138\uC694!"
    - "\uADF8\uCABD \uADF8\uB9BC\uC790 \uBC11\uC5D0 \uC7A0\uAE50 \uC228\uC5B4\uB3C4
      \uB3FC\uBF40\uC694?"
    choices:
    - text: "\uB4E4\uC5B4\uC640"
      reply: "\uD5E4\uD5E4, \uC2DC\uC6D0\uD558\uB2E4~ \uADF8\uCABD \uADF8\uB9BC\uC790
        \uCD5C\uACE0\uC608\uC694\uBF40\uC694!"
      action: 0
    - text: "\uB098\uB3C4 \uB354\uC6CC"
      reply: "\uADF8\uB7FC \uC6B0\uB9AC \uB458 \uB2E4 \uB098\uBB34 \uBC11\uC73C\uB85C
        \uAC00\uC694! \uAC19\uC774 \uC228\uC5B4\uC694\uBF40\uC694!"
      action: 0
  - id: "\uC778\uC0AC_\uC800\uB141"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 3
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB178\uC744\uC774 \uC9C0\uBA74 \uB0B4 \uAC13\uC774 \uB178\uB797\uAC8C \uBB3C\uB4E4\uC5B4\uC694."
    - "\uC608\uC058\uC8E0? \uD5E4\uD5E4\uBF40\uC694."
    choices: []
  - id: "\uC778\uC0AC_\uBC24"
    priority: 20
    weight: 1
    onceOnly: 0
    talk: 2
    time: 4
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBC24\uC774 \uC81C\uC77C \uC88B\uC544\uC694."
    - "\uBCC4\uBE5B \uBC1B\uC73C\uBA74 \uC465\uC465 \uC790\uB77C\uB294 \uAE30\uBD84\uC774\uBF40\uC694!"
    choices: []
  - id: "\uB610\uC634"
    priority: 10
    weight: 1
    onceOnly: 0
    talk: 3
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB610 \uC654\uC5B4\uC694? \uADF8\uCABD \uBC1C\uC18C\uB9AC\uB294 \uC774\uC81C
      \uC54C\uC544\uC694. \uCFF5, \uCFF5, \uD558\uBA74 \uC544, \uC654\uAD6C\uB098
      \uD574\uC694!"
    choices: []
  - id: "\uB610\uC6342"
    priority: 10
    weight: 1
    onceOnly: 0
    talk: 3
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uD5E4\uD5E4, \uB098 \uBCF4\uACE0 \uC2F6\uC5C8\uC5B4\uC694? \uB098\uB3C4 \uADF8\uCABD
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uBF40\uC694."
    choices: []
  - id: "\uC7A1\uB2F4_\uBB3C\uBC2D"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBB3C \uC900 \uBC2D \uC606\uC5D0 \uC549\uC544 \uC788\uC73C\uBA74 \uBC1C\uC774
      \uC2DC\uC6D0\uD574\uC694."
    - "\u2026\uC544, \uB098 \uBC1C \uC5C6\uC9C0\uBF40\uC694."
    choices: []
  - id: "\uC7A1\uB2F4_\uB178\uB798"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC791\uBB3C \uCE5C\uAD6C\uB4E4\uC740 \uB9D0\uC774 \uC5C6\uC5B4\uC694."
    - "\uADF8\uB798\uB3C4 \uB0B4\uAC00 \uB178\uB798 \uBD88\uB7EC \uC8FC\uBA74 \uC465\uC465
      \uC790\uB77C\uB294 \uAC83 \uAC19\uC544\uC694!"
    choices: []
  - id: "\uC7A1\uB2F4_\uB9AC\uB4EC"
    priority: 0
    weight: 1
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB9AC\uB4EC\uC5D0 \uB9DE\uCDB0 \uC218\uD655\uD558\uB294 \uAC70 \uBD24\uC5B4\uC694!"
    - "\uB098\uB3C4 \uAC13\uC73C\uB85C \uBC15\uC790 \uB9DE\uCDB0 \uBD24\uB294\uB370\u2026
      \uC5B4\uC9C0\uB7EC\uC6E0\uBF40\uC694."
    choices: []
  - id: "\uC9C8\uBB38_\uB0A0\uC528"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC788\uC796\uC544\uC694, \uADF8\uCABD\uC740 \uC5B4\uB5A4 \uB0A0\uC528\uAC00
      \uC81C\uC77C \uC88B\uC544\uC694?"
    choices:
    - text: "\uBE44 \uC624\uB294 \uB0A0"
      reply: "\uAE84\uC544! \uB098\uB791 \uB611\uAC19\uC544\uC694! \uC6B0\uB9AC \uBE44
        \uC624\uBA74 \uAC19\uC774 \uB180\uC544\uC694\uBF40\uC694!"
      action: 0
    - text: "\uB9D1\uC740 \uB0A0"
      reply: "\uC73C\uC73C\u2026 \uADF8\uCABD\uC740 \uD587\uBCD5\uC774 \uC548 \uBB34\uC12D\uAD6C\uB098.
        \uBD80\uB7FD\uAE30\uB3C4 \uD558\uACE0 \uBB34\uC12D\uAE30\uB3C4 \uD574\uBF40\uC694."
      action: 0
  - id: "\uC9C8\uBB38_\uD0A4"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 0
    weather: 0
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uB098 \uC5B4\uC81C\uBCF4\uB2E4 \uC870\uAE08 \uCEF8\uC8E0? \uADF8\uB807\uC8E0?"
    choices:
    - text: "\uC751, \uCEF8\uC5B4!"
      reply: "\uC5ED\uC2DC! \uBC24\uC0C8 \uBCC4\uBE5B \uB9CE\uC774 \uBA39\uC5C8\uAC70\uB4E0\uC694.
        \uD5E4\uD5E4\uBF40\uC694!"
      action: 0
    - text: "\uB611\uAC19\uC740\uB370?"
      reply: "\uD788\uC789\u2026 \uAC13\uC774 \uC870\uAE08 \uCEE4\uC9C4 \uAC83 \uAC19\uC558\uB294\uB370\u2026
        \uB0B4\uC77C \uB2E4\uC2DC \uBD10 \uC918\uC694\uBF40\uC694."
      action: 0
  - id: "\uBE44"
    priority: 0
    weight: 3
    onceOnly: 0
    talk: 0
    time: 0
    weather: 2
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uBE44\uB2E4\uC544\uC544! \uAC13 \uC704\uB85C \uD1A1\uD1A1 \uB5A8\uC5B4\uC9C0\uB294
      \uAC70 \uAC04\uC9C0\uB7EC\uC6CC\uC694!"
    - "\uC624\uB298\uC740 \uCD5C\uACE0\uC758 \uB0A0\uC774\uBF40\uC694!"
    choices: []
  - id: "\uB9D1\uC74C"
    priority: 0
    weight: 1.5
    onceOnly: 0
    talk: 0
    time: 2
    weather: 1
    season: 0
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC624\uB298\uC740 \uADF8\uB298\uC5D0\uC11C \uAF3C\uC9DD \uC548 \uD560 \uAC70\uC608\uC694."
    - "\uBC84\uC12F\uC740 \uC6D0\uB798 \uADF8\uB7F0 \uAC70\uBF40\uC694."
    choices: []
  - id: "\uBD04"
    priority: 0
