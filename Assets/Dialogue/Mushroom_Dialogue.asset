    talk: 0
    time: 0
    weather: 0
    season: 1
    minDay: 0
    maxDay: 0
    quest: {fileID: 0}
    questState: 0
    lines:
    - "\uC0C8\uC2F9 \uCE5C\uAD6C\uB4E4\uC774 \uC794\uB729 \uC0DD\uACBC\uC5B4\uC694!"
    - "\uB2E4\uB4E4 \uB098\uBCF4\uB2E4 \uD0A4\uAC00 \uCEE4\uC11C \uC870\uAE08 \uC0D8\uB098\uBF40\uC694."
    choices: []
  - id: "\uC5EC\uB984"
